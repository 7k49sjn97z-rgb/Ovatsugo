{
  "name": "ovatsugo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:generate": "prisma generate",
    "typecheck": "tsc --noEmit",
    "build:vercel": "npm run config:check && npm run db:generate && npm run db:migrate && npm run db:check && npm run build",
    "config:check": "node --env-file-if-exists=.env --import tsx scripts/check-config.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx scripts/check-database.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.ts\" \"*.{ts,js,json}\""
  },
  "repository": {
